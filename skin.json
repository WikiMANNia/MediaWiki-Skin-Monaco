{
	"name": "Monaco",
	"version": "2.9.0",
	"requires": {
		"MediaWiki": ">= 1.39.0"
	},
	"author": [
		"'''Universal Omega'''",
		"WikiMANNia",
		"Inez Korczyński",
		"Christian Williams",
		"Daniel Friesen",
		"James Haley",
		"Roger Meier"
	],
	"url": "https://www.mediawiki.org/wiki/Skin:Monaco",
	"descriptionmsg": "monaco-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "skin",
	"callback": "MediaWiki\\Skin\\Monaco\\MonacoHooks::onRegistration",
	"ValidSkinNames": {
		"monaco": {
			"displayname": "Monaco",
			"class": "MediaWiki\\Skin\\Monaco\\SkinMonaco",
			"args": [ {
				"name": "monaco",
				"bodyOnly": true,
				"menus": [
					"associated-pages",
					"views",
					"actions",
					"variants"
				],
				"template": "MediaWiki\\Skin\\Monaco\\MonacoTemplate",
				"styles": [
					"skins.monaco"
				],
				"scripts": [
					"skins.monaco.scripts"
				]
			} ]
		}
	},
	"MessagesDirs": {
		"Monaco": [
			"i18n"
		]
	},
	"ConfigRegistry": {
		"monaco": "GlobalVarConfig::newInstance"
	},
	"ResourceModules": {
		"skins.monaco": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"elements": true,
				"content-links-external": true,
				"content-links": true,
				"content-media": true,
				"content-tables": true,
				"interface-message-box": true,
				"interface-category": true,
				"i18n-ordered-lists": true,
				"i18n-all-lists-margins": true,
				"i18n-headings": true
			},
			"targets": [
				"desktop",
				"mobile"
			],
			"position": "top",
			"styles": {
				"style/css/print.css": {
					"media": "print"
				},
				"style/css/monobook_modified.css": {
					"media": "screen"
				},
				"style/css/reset_modified.css": {
					"media": "screen"
				},
				"style/css/root.css": {
					"media": "screen"
				},
				"style/css/header.css": {
					"media": "screen"
				},
				"style/css/article.css": {
					"media": "screen"
				},
				"style/css/widgets.css": {
					"media": "screen"
				},
				"style/css/footer.css": {
					"media": "screen"
				},
				"style/css/ny.css": {
					"media": "screen"
				},
				"style/css/buttons.css": {
					"media": "screen"
				},
				"style/css/sprite.css": {
					"media": "screen"
				},
				"style/css/modal.css": {
					"media": "screen"
				},
				"style/css/star_rating.css": {
					"media": "screen"
				}
			}
		},
		"skins.monaco.scripts": {
			"scripts": "style/js/monaco.js"
		},
		"skins.monaco.widget": {
			"position" : "bottom",
			"scripts": "style/js/monacoWidget.js",
			"styles": {
				"style/css/monacoWidget.css": {
					"media": "screen"
				}
			}
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Monaco"
	},
	"config": {
		"MonacoAllowUseTheme": {
			"type": "boolean",
			"value": true
		},
		"MonacoTheme": {
			"type": "string",
			"value": "sapphire"
		},
		"MonacoDynamicCreateOverride": {
			"type": "boolean",
			"value": false
		},
		"MonacoUseMoreButton": {
			"type": "boolean",
			"value": true
		},
		"MonacoUseSitenoticeIsland": {
			"type": "boolean",
			"value": false
		},
		"MonacoUseMasthead": {
			"type": "boolean",
			"value": true
		},
		"MonacoCompactSpecialPages": {
			"type": "boolean",
			"value": false
		},
		"MonacoBiggestCategoriesBlacklist": {
			"type": "array",
			"value": []
		},
		"MonacoEnablePaypal": {
			"type": "boolean",
			"value": false
		},
		"MonacoPaypalID": {
			"type": "string",
			"value": ""
		},
		"MonacoEnablePatreon": {
			"type": "boolean",
			"value": false
		},
		"MonacoPatreonURL": {
			"type": "string",
			"value": ""
		},
		"MonacoSearchDefaultFulltext": {
			"type": "boolean",
			"value": false
		},
		"MonacoSpecialPagesRequiredLogin": {
			"type": "array",
			"value": []
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skin\\Monaco\\": "includes/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Skin\\Monaco\\MonacoHooks",
			"services": [
				"MainConfig",
				"UserOptionsLookup"
			]
		}
	},
	"Hooks": {
		"GetPreferences": "main",
		"MessageCacheReplace": [
			"MonacoSidebar::invalidateCache"
		],
		"OutputPageBodyAttributes": "main"
	},
	"manifest_version": 2
}
